# Expo SDK 58: @react-native-community/datetimepicker 9.2.1 lists
# react-native-windows as an OPTIONAL peer, and react-native-windows pins
# react-native ^0.85 while SDK 58 is on 0.88. npm's strict peer resolution
# treats that as a hard conflict even though nothing here installs or uses
# react-native-windows. npm "overrides" do not reach optional peer ranges, so
# this is the fix. Revisit when datetimepicker or react-native-windows catches up.
legacy-peer-deps=true
